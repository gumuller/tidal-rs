	depends = gtk4>=4.12
	depends = glib2
	depends = glibc
	depends = gcc-libs
	depends = mpv
	depends = libpulse
	depends = xdg-utils
	optdepends = pipewire-pulse: PulseAudio-compatible audio server
	optdepends = ttf-jetbrains-mono-nerd: console-style interface font
	options = !lto
	options = !debug
	source = git+https://github.com/gumuller/tidal-rs.git#tag=v0.6.1
	sha256sums = SKIP

pkgname = tidal-rs
