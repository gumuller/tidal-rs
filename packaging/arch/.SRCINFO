pkgbase = tidal-rs
	pkgdesc = Native Rust/GTK4 TIDAL music player with FFT visualizations
	pkgver = 0.6.1
	pkgrel = 1
	url = https://github.com/gumuller/tidal-rs
	arch = x86_64
	license = MIT
	makedepends = rust
	makedepends = cargo
	makedepends = git
	makedepends = cmake
